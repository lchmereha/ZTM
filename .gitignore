# ┌──────────────────────────────────────────────────────────────────┐
# │  .gitignore — Raiz do Projeto ZTM                                │
# │                                                                  │
# │  Os subprojetos (backend/, frontend/, mobile/) têm .gitignore    │
# │  próprios. Este arquivo cobre a raiz e o que é comum a todos.    │
# │                                                                  │
# │  Antes do primeiro push, rode:                                   │
# │    git status --porcelain | grep -iE "\.env|key\.properties|jks" │
# │  Se retornar algo além de *.example, PARE.                       │
# └──────────────────────────────────────────────────────────────────┘

# ── Segredos ─────────────────────────────────────────────────────
# .env da raiz: credenciais do MySQL e domínios de produção.
# Os *.example ficam versionados de propósito — são o template.
.env
.env.*
!.env.example
!.env.*.example

# Assinatura de aplicativo. Vazar isto permite publicar um APK que o Android
# aceita como se fosse de vocês.
*.jks
*.keystore
*.p12
*.pfx
key.properties

# Chaves e certificados
*.pem
*.key
!**/public/**/*.key
id_rsa*
*.ppk

# ── Área de trabalho local ───────────────────────────────────────
# Contém CÓPIAS DE OUTROS PROJETOS (zwm, zwm-app, tech_wall), com .env reais,
# key.properties e dump de banco. Nada disso pode ir para um remoto.
.tmp/

# Dumps e backups de banco — podem conter dados reais de cliente.
*.sql.gz
*.dump
*_backup.sql
*-backup.sql

# ── Metadados de outro sistema de versionamento ──────────────────
# O projeto vem de SVN. O .svn/pristine guarda cópia íntegra de todo arquivo
# já versionado — commitar isso duplicaria a árvore inteira no histórico do
# Git e poderia arrastar conteúdo antigo junto.
.svn/

# ── Dependências e artefatos de build ────────────────────────────
node_modules/
dist/
build/
.yarn/cache
.yarn/install-state.gz
*.tsbuildinfo

# ── Ferramentas ──────────────────────────────────────────────────
graphify-out/
.claude/
.vscode/
.idea/

# ── Sistema operacional ──────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~

# ── Logs ─────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Misc ─────────────────────────────────────────────────────────
play-store/
DEPLOY-COOLIFY.md
PUBLICACAO-PLAY-STORE.md
