/android/app/debug
/android/app/profile
/android/app/release

# Cobre .env, .env.local, .env.development, .env.production e afins.
# Os *.example ficam versionados de propósito.
.env
.env.*
!.env.example
!.env.*.example

# ── Assinatura do app (NUNCA versionar) ──────────────────────────
# key.properties guarda as senhas da keystore. Com ele + o .jks, qualquer
# pessoa publica um APK que o Android aceita como legítimo de vocês.
key.properties
*.jks
*.keystore

# Caminhos de SDK específicos da máquina de cada dev.
local.properties
