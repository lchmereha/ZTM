<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31). Nada do app deve sair do aparelho: o GetStorage guarda
  o endereço do servidor da filial, e a sessão é intencionalmente só em memória
  (coletores são compartilhados entre operadores). Backup em nuvem e
  transferência device-to-device ficam desligados.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
