# ┌──────────────────────────────────────────────────────────────────┐
# │  frontend/.env.production — Ambiente de Produção (Cloud)       │
# │                                                                │
# │  Consumido por: docker-compose-production.yml                  │
# │  Build de produção do frontend servido por Nginx na nuvem.     │
# │  A URL do backend deve apontar para o domínio real da API.     │
# │                                                                │
# │  ⚠️  Este arquivo NÃO deve ser versionado.                     │
# │  Copie este .env.production.example → .env.production          │
# │  e preencha os valores reais.                                  │
# └──────────────────────────────────────────────────────────────────┘

# ── Versão do App ───────────────────────────────────────────────
VITE_APP_VERSION=v0.0.0

# ── Rota Base ───────────────────────────────────────────────────
# Prefixo de URL onde o frontend é servido.
VITE_APP_BASE_NAME=/ztm

# ── URL do Backend ──────────────────────────────────────────────
# Em produção (AWS, etc.), aponte para o domínio real da API.
# Use HTTPS em produção.
VITE_BACKEND_URL=https://api.seu-dominio.com
