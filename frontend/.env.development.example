# ┌──────────────────────────────────────────────────────────────────┐
# │  frontend/.env.development — Desenvolvimento com Docker        │
# │                                                                │
# │  Consumido por: docker-compose-development.yml                 │
# │  O Vite roda em modo dev com hot-reload dentro do container.   │
# │  O backend é acessado via http://localhost:3000 (porta mapeada)│
# │                                                                │
# │  ⚠️  Este arquivo NÃO deve ser versionado.                     │
# │  Copie este .env.development.example → .env.development        │
# │  e preencha os valores reais.                                  │
# └──────────────────────────────────────────────────────────────────┘

# ── Versão do App ───────────────────────────────────────────────
# Exibida na UI para identificar a build. Atualize a cada release.
VITE_APP_VERSION=v0.0.0

# ── Source Maps ─────────────────────────────────────────────────
# Desative em produção para evitar expor código-fonte.
GENERATE_SOURCEMAP=false

# ── Rota Base ───────────────────────────────────────────────────
# Prefixo de URL onde o frontend é servido.
# Exemplos: "/app", "/ztm", "/"
VITE_APP_BASE_NAME=/app

# ── URL do Backend ──────────────────────────────────────────────
# Endereço completo da API NestJS.
# Em desenvolvimento, aponte para localhost na porta do backend.
VITE_BACKEND_URL=http://127.0.0.1:3000
