# Build do Vite para o deploy no Coolify (docker-compose-coolify.yml).
#
# Consumido em tempo de BUILD, não em runtime: o Dockerfile.production copia
# este arquivo por cima de .env.production quando APP_MODE=coolify, e o Vite
# embute os valores no bundle. Mudar aqui exige rebuild — redeploy sem rebuild
# não muda nada.
#
# Versionado de propósito: são parâmetros públicos de build, não segredo.
# Tudo que o Vite injeta via import.meta.env vai para o JS do navegador.

VITE_APP_VERSION=v5.1.0
VITE_APP_BASE_NAME=/ztm

# Caminho relativo, não domínio: no Coolify a stack usa um único domínio e o
# nginx do próprio frontend faz proxy de /ztm/api/ para backend:3000. Isso
# evita CORS, dispensa segundo certificado e permite COOKIE_SAMESITE=lax.
VITE_BACKEND_URL=/ztm/api
