# ┌──────────────────────────────────────────────────────────────────┐
# │  frontend/.env.local — Ambiente Docker Local (Rede Interna)    │
# │                                                                │
# │  Consumido por: docker-compose-local.yml                       │
# │  Build de produção do frontend servido por Nginx.              │
# │  O Nginx faz proxy reverso: /api → backend:3000               │
# │                                                                │
# │  ⚠️  Este arquivo NÃO deve ser versionado.                     │
# │  Copie este .env.local.example → .env.local                    │
# │  e preencha os valores reais.                                  │
# └──────────────────────────────────────────────────────────────────┘

# ── Versão do App ───────────────────────────────────────────────
VITE_APP_VERSION=v0.0.0

# ── Rota Base ───────────────────────────────────────────────────
# Prefixo de URL onde o frontend é servido pelo Nginx.
VITE_APP_BASE_NAME=/ztm

# ── URL do Backend ──────────────────────────────────────────────
# Em ambiente local, o Nginx redireciona a rota /api para o
# serviço backend:3000 internamente. Por isso, use um caminho
# relativo ao invés de um endereço absoluto.
VITE_BACKEND_URL=/api
