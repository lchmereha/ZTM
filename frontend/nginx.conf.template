# Template processado por envsubst no start do container (entrypoint da imagem
# nginx). As duas variantes usam este mesmo arquivo, mudando só APP_BASE_PATH:
#   default  -> /ztm
#   marluvas -> /ztm-marluvas
#
# NGINX_ENVSUBST_FILTER=^APP_ garante que só as variáveis APP_* sejam
# substituídas — sem isso o envsubst apagaria $uri, $host, $remote_addr etc.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name localhost;

    # O container escuta em 8080, mas é publicado em outra porta (80 no compose,
    # 443 atrás do Traefik). Com absolute_redirect ligado — o padrão — o nginx
    # monta o Location com a porta interna, e o cliente é mandado para
    # http://host:8080/, onde não há nada. Relativo, o cliente resolve contra o
    # host:porta que ele mesmo usou.
    absolute_redirect off;

    location ${APP_BASE_PATH}/ {
        alias /usr/share/nginx/html/;
        index index.html index.htm;
        try_files $uri $uri/ ${APP_BASE_PATH}/index.html;
    }

    location = ${APP_BASE_PATH} {
        return 301 ${APP_BASE_PATH}/;
    }

    location = / {
        return 301 ${APP_BASE_PATH}/;
    }

    # Política de privacidade do app mobile, publicada na ficha da Play Store.
    #
    # Match exato porque o bloco ${APP_BASE_PATH}/ acima tem fallback de SPA:
    # sem extensão, /mobile cairia no index.html do React em vez do documento.
    # O arquivo vem de frontend/public/legal/, que o Vite copia para o dist.
    #
    # Cache curto de propósito: uma revisão da política precisa aparecer em
    # minutos, não depois do TTL padrão do navegador.
    location = ${APP_BASE_PATH}/mobile {
        alias /usr/share/nginx/html/legal/mobile.html;
        default_type text/html;
        add_header Cache-Control "public, max-age=300";
    }

    # version.json é lido pelo useBuildVersionCheck a cada troca de rota:
    # precisa refletir o deploy novo, nunca vir do cache.
    location = ${APP_BASE_PATH}/version.json {
        alias /usr/share/nginx/html/version.json;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        expires -1;
    }

    # Proxy reverso para o backend, para evitar CORS.
    location ${APP_BASE_PATH}/api/ {
        proxy_pass http://backend:3000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Necessários caso algum endpoint passe a usar WebSocket.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    include /etc/nginx/conf.d/extra/*.conf;
}
