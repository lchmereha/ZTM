# ┌──────────────────────────────────────────────────────────────────┐
# │  backend/.env — Desenvolvimento local (sem Docker)               │
# │                                                                  │
# │  Usado quando o NestJS roda diretamente na máquina               │
# │  (npm run start:dev) apontando para um MySQL local.              │
# │                                                                  │
# │  ⚠️  Este arquivo NÃO deve ser versionado.                       │
# │  Copie este .env.example → .env e preencha os valores reais.     │
# └──────────────────────────────────────────────────────────────────┘

# ── Configuração da Base de Dados (MySQL) ────────────────────────
# String de conexão Prisma ORM. Formato:
#   mysql://<usuario>:<senha>@<host>:<porta>/<banco>
# Obs: caracteres especiais na senha devem ser URL-encoded (ex: @ → %40)
#
# Em dev local sem Docker, você gerencia o MySQL manualmente.
# Recomendado criar um usuário dedicado ao invés de usar root.
#
# ⚠️ Se estiver usando Docker Compose, as credenciais (usuário, senha
# e nome do banco) DEVEM ser idênticas às configuradas no .env da raiz.
DATABASE_URL="mysql://ztm_app:senha@localhost:3306/ztm_db"

# ── Shadow Database (Prisma Migrations) ─────────────────────────
# O Prisma necessita de permissão CREATE DATABASE para gerar migrações.
# Caso o usuário definido na DATABASE_URL não tenha essa permissão (comum em
# usuários não-root), informe aqui as credenciais do root para o shadow DB.
#
# Exemplo (Docker local): mysql://root:senha@localhost:3306/prisma_shadow
SHADOW_DATABASE_URL="mysql://root:senha@localhost:3306/prisma_shadow"

# Quantidade de conexões simultâneas no pool do Prisma (opcional).
# Descomente se precisar ajustar para cargas maiores.
# DATABASE_POOL_SIZE=10

# ── JWT (JSON Web Token) ────────────────────────────────────────
# Segredo usado para assinar tokens de autenticação.
# Use uma string longa e aleatória (mínimo 32 caracteres).
JWT_SECRET="segredo-super-secreto-alterar-depois"

# Tempo de expiração do token. Exemplos: "1d", "12h", "30m"
JWT_EXPIRES_IN="1d"

# Teto nominal da sessao, contado do login original. O interceptor deslizante
# renova o token a partir da metade de JWT_EXPIRES_IN, mas para de renovar ao
# atingir este teto -- e a validacao passa a recusar o token. Default: 30d.
SESSION_ABSOLUTE_TTL="30d"

# ── Servidor NestJS ─────────────────────────────────────────────
# Porta HTTP na qual o servidor escuta.
PORT=3000

# ── Credenciais do Admin Seed ───────────────────────────────────
# Usuário e senha do administrador criado automaticamente ao rodar
# o seed do Prisma (npx prisma db seed). Altere antes do primeiro uso.
ADMIN_USERNAME="USUARIO"
ADMIN_PASSWORD="SENHA"

# ── CORS (Cross-Origin Resource Sharing) ────────────────────────
# Em produção (NODE_ENV=production), apenas estas origens são aceitas.
# Separe múltiplas origens por vírgula: http://app.com,http://admin.com
# Em desenvolvimento (NODE_ENV != production), CORS é permissivo.
ALLOWED_ORIGINS=http://127.0.0.1

# ── Ambiente de Execução ────────────────────────────────────────
# "production" → CORS restritivo + Swagger desabilitado
# qualquer outro valor ou omitido → CORS permissivo + Swagger habilitado
NODE_ENV=development

# ── Configuração de Cookie de Autenticação ──────────────────────
# O token JWT é enviado via cookie httpOnly (inacessível ao JavaScript).
#
# COOKIE_SECURE controla a flag "Secure" do cookie:
#   false → Cookie é enviado em conexões HTTP (padrão para rede local)
#   true  → Cookie só é enviado em conexões HTTPS
#
# ⚠️ IMPORTANTE:
#   - Em deploys de REDE LOCAL via HTTP: mantenha como false.
#     Se definir como true em HTTP, o cookie NÃO será enviado pelo
#     browser e a autenticação falhará silenciosamente (401).
#   - Em deploys com HTTPS (proxy reverso com TLS): defina como true
#     para impedir que o cookie trafegue em conexões inseguras.
COOKIE_SECURE=false

# ── Serviço Externo de Consulta de CEP ──────────────────────────
# URL base da API utilizada para consultar endereços por CEP.
# Pode ser substituída caso o provedor atual apresente instabilidade
# ou vulnerabilidades. O formato esperado é: <base_url>/<cep>/json/
CEP_API_URL=https://viacep.com.br/ws

# ── Proxy reverso ────────────────────────────────────────────────
# Número de proxies confiáveis à frente da API (Traefik = 1, ALB+Traefik = 2).
# Sem isso o ThrottlerGuard enxerga o IP do proxy e trata TODOS os coletores
# da planta como um único cliente, estourando o limite de 60 req/min.
# 0 ou ausente = não confia em nenhum proxy (correto para acesso direto).
TRUSTED_PROXY_HOPS=0

# ── Cookie de sessão ─────────────────────────────────────────────
# Política SameSite do cookie de autenticação.
#   lax   → frontend e API no MESMO domínio registrável (ex.: app.x.com + api.x.com)
#   none  → domínios registráveis DIFERENTES; exige HTTPS (COOKIE_SECURE=true)
# Com `lax` em domínios distintos o browser NÃO envia o cookie em XHR e o
# login simplesmente não funciona.
COOKIE_SAMESITE=lax

# ── População de demonstração ────────────────────────────────────
# Cria empresa, filiais, produtos, tags e movimentações fictícias, além do
# usuário DEMOZZ. Serve para a revisão da Google Play navegar pelo app.
#   true            → executa a população (prisma/seed-demo.ts)
#   false ou ausente → não executa
# ⚠️ NUNCA habilite em ambiente de cliente.
SEED_DEMO=false

# Credenciais do usuário de demonstração criado quando SEED_DEMO=true.
# São as que você informa à Google no campo "Acesso ao app" da Play Console.
# Obrigatórias quando SEED_DEMO=true — o seed falha sem elas, de propósito.
DEMO_USERNAME=DEMOZZ
DEMO_PASSWORD=troque-esta-senha
