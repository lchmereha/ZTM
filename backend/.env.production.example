# ┌──────────────────────────────────────────────────────────────────┐
# │  backend/.env.production — Ambiente Docker Produção (Cloud)    │
# │                                                                │
# │  Consumido por: docker-compose-production.yml                  │
# │  Deploy final em nuvem (AWS, etc.) com HTTPS via proxy reverso.│
# │  CORS restritivo e Swagger desabilitado.                       │
# │  O host do banco é "db" (ou o endpoint do RDS se gerenciado).  │
# │                                                                │
# │  ⚠️  Este arquivo NÃO deve ser versionado.                     │
# │  Copie este .env.production.example → .env.production          │
# │  e preencha os valores reais.                                  │
# └──────────────────────────────────────────────────────────────────┘

# ── Configuração da Base de Dados (MySQL) ────────────────────────
# String de conexão Prisma ORM.
# Se usar RDS (AWS), substitua "db" pelo endpoint do RDS.
# Exemplo: mysql://usuario:senha@meu-rds.xxxx.us-east-1.rds.amazonaws.com:3306/banco
#
# ⚠️ IMPORTANTE: Se estiver usando o serviço "db" do Docker Compose,
# as credenciais abaixo DEVEM ser idênticas às variáveis DB_USER,
# DB_PASS e DB_NAME configuradas no .env da raiz do projeto.
# Se alterar lá, atualize aqui também (e vice-versa).
#
# ⚠️ O Prisma exige que isso seja uma string literal (não interpola variáveis).
# Caracteres especiais na senha devem ser URL-encoded (ex: @ → %40).
# Formato: mysql://<DB_USER>:<DB_PASS>@db:3306/<DB_NAME>
DATABASE_URL="mysql://ztm_app:senha@db:3306/meu_banco_producao"

# ── Shadow Database (Prisma Migrations) ─────────────────────────
# O Prisma necessita de permissão CREATE DATABASE para gerar migrações.
# Caso o usuário definido na DATABASE_URL não tenha essa permissão (comum em
# usuários não-root), informe aqui as credenciais do root para o shadow DB.
#
# Exemplo (Docker local): mysql://root:senha@localhost:3306/prisma_shadow
SHADOW_DATABASE_URL="mysql://root:senha@localhost:3306/prisma_shadow"

# ── JWT (JSON Web Token) ────────────────────────────────────────
# Em produção, use um segredo aleatório forte (mínimo 64 caracteres).
# Gere com: openssl rand -hex 32
JWT_SECRET="GERE_COM_openssl_rand_-hex_32"

# Tempo de expiração do token.
JWT_EXPIRES_IN="1d"

# ── Servidor NestJS ─────────────────────────────────────────────
PORT=3000

# ── Credenciais do Admin Seed ───────────────────────────────────
# Use credenciais fortes. Altere após o primeiro login.
ADMIN_USERNAME="USUARIO_ADMIN"
ADMIN_PASSWORD="SENHA_FORTE_PRODUCAO"

# ── CORS e Ambiente ─────────────────────────────────────────────
# Em produção, CORS aceita APENAS as origens listadas.
# Separe múltiplas origens por vírgula.
ALLOWED_ORIGINS=https://seu-dominio-frontend.com.br
NODE_ENV=production

# ── Configuração de Cookie de Autenticação ──────────────────────
# Em produção com HTTPS, DEVE ser true para segurança.
# Veja documentação completa em backend/.env.example.
COOKIE_SECURE=true

# ── Serviço Externo de Consulta de CEP ──────────────────────────
CEP_API_URL=https://viacep.com.br/ws

# ── Proxy reverso ────────────────────────────────────────────────
# Número de proxies confiáveis à frente da API (Traefik = 1, ALB+Traefik = 2).
# Sem isso o ThrottlerGuard enxerga o IP do proxy e trata TODOS os coletores
# da planta como um único cliente, estourando o limite de 60 req/min.
# 0 ou ausente = não confia em nenhum proxy (correto para acesso direto).
TRUSTED_PROXY_HOPS=1

# ── Cookie de sessão ─────────────────────────────────────────────
# Política SameSite do cookie de autenticação.
#   lax   → frontend e API no MESMO domínio registrável (ex.: app.x.com + api.x.com)
#   none  → domínios registráveis DIFERENTES; exige HTTPS (COOKIE_SECURE=true)
# Com `lax` em domínios distintos o browser NÃO envia o cookie em XHR e o
# login simplesmente não funciona.
COOKIE_SAMESITE=none

# ── População de demonstração ────────────────────────────────────
# Cria empresa, filiais, produtos, tags e movimentações fictícias, além do
# usuário DEMOZZ. Serve para a revisão da Google Play navegar pelo app.
#   true            → executa a população (prisma/seed-demo.ts)
#   false ou ausente → não executa
# ⚠️ NUNCA habilite em ambiente de cliente.
SEED_DEMO=false

# Credenciais do usuário de demonstração criado quando SEED_DEMO=true.
# São as que você informa à Google no campo "Acesso ao app" da Play Console.
# Obrigatórias quando SEED_DEMO=true — o seed falha sem elas, de propósito.
DEMO_USERNAME=DEMOZZ
DEMO_PASSWORD=troque-esta-senha
