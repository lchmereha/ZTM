# ┌──────────────────────────────────────────────────────────────────┐
# │  .env — Raiz do Projeto (Docker Compose)                         │
# │                                                                  │
# │  Consumido por: docker-compose-local.yml                         │
# │                 docker-compose-development.yml                   │
# │                 docker-compose-production.yml                    │
# │                                                                  │
# │  ⚠️  Este arquivo NÃO deve ser versionado.                       │
# │  Copie este .env.example → .env e preencha os valores reais.     │
# └──────────────────────────────────────────────────────────────────┘

# ── Banco de Dados MySQL ─────────────────────────────────────────
# Nome do banco criado automaticamente pelo container MySQL.
DB_NAME=meu_banco

# Senha do usuário root do MySQL (usada apenas para admin/healthcheck).
DB_ROOT_PASS=senha_root

# Usuário dedicado da aplicação (criado automaticamente pelo MySQL).
# Recebe permissões completas APENAS sobre o banco DB_NAME.
DB_USER=ztm_app

# Senha do usuário dedicado da aplicação.
DB_PASS=senha_app

# ⚠️ IMPORTANTE: Após configurar as variáveis acima, você DEVE atualizar
# a DATABASE_URL no .env correspondente do backend (backend/.env.<ambiente>)
# com as mesmas credenciais. Exemplo:
#   DATABASE_URL="mysql://<DB_USER>:<DB_PASS>@db:3306/<DB_NAME>"


# ── Variante white-label (apenas docker-compose-local) ───────────
# Controla se o serviço `frontend-marluvas` sobe. A variante existe só para
# demonstração e apresentação; produção nunca a utiliza.
#
#   COMPOSE_PROFILES=marluvas   → sobe a variante em /ztm-marluvas/
#   ausente ou vazio            → não sobe; /ztm-marluvas/ responde 404
#
# É o mecanismo nativo de perfis do Docker Compose: com o serviço fora do
# perfil ativo, ele não é sequer criado. Deixe comentado para não subir.
#
# COMPOSE_PROFILES=marluvas


# ── Produção AWS (apenas docker-compose-production) ──────────────
# Não são usadas pelo compose local. Sem elas o Traefik não sobe e não há
# emissão de certificado.

# Domínio do frontend web. Precisa ter registro DNS apontando para o IP da
# instância EC2 ANTES do primeiro `up` — o Let's Encrypt valida por ele.
# Também compõe o ALLOWED_ORIGINS do backend (CORS).
APP_DOMAIN=app.seudominio.com.br

# Domínio da API. Registro DNS próprio, mesma instância.
# Fica em domínio separado do frontend, por isso o backend usa
# COOKIE_SAMESITE=none — ver docker-compose-production.yml.
API_DOMAIN=api.seudominio.com.br

# E-mail informado ao Let's Encrypt na emissão. Recebe aviso de expiração de
# certificado. Use um endereço monitorado, não pessoal.
ACME_EMAIL=contato@seudominio.com.br

# ⚠️ A política de privacidade do app mobile é servida pelo próprio container
# do frontend em https://<APP_DOMAIN>/ztm/mobile — é essa URL que vai na ficha
# da Play Store. Ela só existe depois que este compose estiver no ar com
# certificado válido.

